<script>
(function(){
  var w=document.getElementById("nxi");
  if(!w)return;
  document.cookie="nx_intro=1; path=/; expires="+new Date(Date.now()+1800000).toUTCString();
  var motto=document.getElementById("nxi-motto");
  var inner=w.children[0];
  var footer=w.children[1];
  var bar=document.getElementById("nxi-bar");
  var barStart=null;
  var pctEl=document.getElementById("nxi-bar-pct");
  var loadingTxt=document.getElementById("nxi-loading-txt");
  function removeOverlay(){
    w.style.transition="opacity 1.2s ease";
    w.style.opacity="0";
    setTimeout(function(){
      if(w.parentNode)w.parentNode.removeChild(w);
    },1300);
  }
  function animateBar(ts){
    if(!barStart)barStart=ts;
    var pct=Math.min((ts-barStart)/3000*100,100);
    bar.style.width=Math.round(pct)+"%";
    if(pctEl)pctEl.textContent=Math.round(pct)+"%";
    if(pct<100){
      requestAnimationFrame(animateBar);
    } else {
      if(loadingTxt)loadingTxt.style.display="block";
      if(pctEl)pctEl.style.opacity="0";
    }
  }
  var exitDone=false;
  function doExit(){
    if(exitDone)return;
    exitDone=true;
    inner.style.transition="opacity .6s ease";
    inner.style.opacity="0";
    footer.style.borderTop="none";
    setTimeout(function(){
      inner.style.display="none";
      motto.style.fontSize="2.8rem";
      motto.style.letterSpacing=".25em";
      setTimeout(removeOverlay,2500);
    },650);
  }
  setTimeout(doExit,12000);
  requestAnimationFrame(animateBar);
  window.addEventListener("pageshow",function(e){
    if(e.persisted){barStart=null;requestAnimationFrame(animateBar);}
  });
(function(){
  var PW_URL='https://docs.google.com/spreadsheets/d/e/2PACX-1vQT6dFLvqEDKW6UBHoMsr237H3mFu1WjmfKDOCJT1KGf2AQV3eU3jMFQQta_J8qGE9KCAadjIEZXoms/pub?output=csv';
  function parseNum(s){return s?parseFloat(s.replace(/[$,%\s]/g,'')):NaN;}
  function fmt(n){return '$'+n.toLocaleString('en-CA',{minimumFractionDigits:2,maximumFractionDigits:2});}
  function animBar(fillId,dollarId,pctId,dollarVal,pctVal,delay){
    setTimeout(function(){
      var fill=document.getElementById(fillId);
      var dEl=document.getElementById(dollarId);
      var pEl=document.getElementById(pctId);
      if(!fill||!dEl||!pEl)return;
      fill.style.width=Math.min(pctVal,100)+'%';
      var start=null;
      function step(ts){
        if(!start)start=ts;
        var p=Math.min((ts-start)/1800,1);
        var v=1-Math.pow(1-p,3);
        dEl.textContent=fmt(dollarVal*v);
        pEl.textContent=(pctVal*v).toFixed(2)+'%';
        if(p<1)requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    },delay);
  }
  fetch('https://api.codetabs.com/v1/proxy?quest='+encodeURIComponent(PW_URL))
  .then(function(r){return r.text();})
  .then(function(text){
    var lines=text.trim().split('\n');
    if(lines.length<2)return;
    var vals=lines[1].split(',');
    var raised=parseNum(vals[0]);
    var net=parseNum(vals[1]);
    if(isNaN(raised)||isNaN(net)||net===0)return;
    var classF=(net/raised)*100;
    var classA=classF*0.9475;
    animBar('nxi-bar-a','nxi-nav-a-dollar','nxi-nav-a-pct',classA,classA,300);
    animBar('nxi-bar-f','nxi-nav-f-dollar','nxi-nav-f-pct',classF,classF,600);
    setTimeout(doExit,1800+3500);
  }).catch(function(){doExit();});
})();
fetch("https://ipapi.co/json/")
.then(function(r){return r.json();})
.then(function(d){
  var city=d.city||"";
  var lat=d.latitude;
  var lon=d.longitude;
  if(!city||!lat)return;
  fetch("https://api.open-meteo.com/v1/forecast?latitude="+lat+"&longitude="+lon+"&current_weather=true")
  .then(function(r){return r.json();})
  .then(function(w){
    var temp=Math.round(w.current_weather.temperature);
    var el=document.getElementById("nxi-weather");
    if(el){el.textContent=city+"  |  "+temp+"°C";el.style.display="block";}
  });
}).catch(function(){});
})();
</script>
